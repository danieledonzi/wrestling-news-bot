{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "disposition", "reason"],
        "properties": {
          "ref": {"type": "string", "pattern": "^s[0-9]+$"},
          "disposition": {"enum": ["SOFT_MUST", "SOFT_SHOULD", "SOFT_SKIP"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
