        "type": "string",
        "presence": "optional"
      },
      {
        "name": "error_terminal",
        "type": "boolean_or_null",
        "presence": "optional"
      },
      {
        "name": "artifact_refs",
        "type": "array",
        "presence": "required"
      },
      {
        "name": "code_commit",
        "type": "string",
        "presence": "optional"
      }
    ],
    "required_fields": [
      "schema_version",
      "policy_version",
      "timestamp_utc",
      "run_id",
      "stage",
      "agent",
      "event_type",
      "status",
      "artifact_refs"
    ],
    "optional_fields": [
      "article_id",
      "pair_id",
      "correlation_id",
      "content_id",
      "story_id",
      "report_key",
      "logical_request_id",
      "attempt_id",
      "attempt_number",
      "result",
      "reason_code",
      "model_name",
      "model_role",
      "fallback_from",
      "fallback_to",
      "latency_ms",
      "error_class",
      "error_terminal",
      "code_commit"
    ],
    "conditional_requirements": [
      {
        "id": "model_attempt_identity",
        "when_event_types": [
          "model_attempt_started",
          "model_attempt_completed",
          "model_attempt_failed"
        ],
        "require": [
          "logical_request_id",
          "attempt_id",
          "attempt_number",
          "model_name",
          "model_role"
        ],
        "rule": "Concrete model attempts require a logical parent, unique attempt identity, and 1-based ordinal."
      },
      {
        "id": "avoided_request_identity",
        "when_event_types": [
          "model_attempt_avoided"
        ],
        "require": [
          "logical_request_id",
          "model_role"
        ],
        "forbid": [
          "attempt_id",
          "attempt_number",
          "latency_ms"
        ],
        "rule": "Avoided means no concrete API attempt; no attempt identity, ordinal, or latency exists."
      },
      {
        "id": "fallback_models",
        "when_event_types": [
          "fallback_started"
        ],
        "require": [
          "logical_request_id",
          "fallback_from",
          "fallback_to"
        ],
        "rule": "Fallback transition names both models and retains the logical request."
      },
      {
        "id": "failed_error",
        "when_event_types": [
          "stage_failed",
          "model_attempt_failed",
          "publication_failed"
        ],
        "require": [
          "error_class",
          "error_terminal"
        ],
        "rule": "Failure events classify the error and state terminality."
      },
      {
        "id": "duplicate_pair_identity",
        "when_event_types": [
          "duplicate_pair_evaluated",
          "duplicate_pair_resolved",
          "duplicate_pair_unresolved"
        ],
        "require": [
          "pair_id"
        ],
        "rule": "Every duplicate-pair outcome identifies the scoped pair; left/right article IDs remain legacy/artifact context."
      }
    ]
  },
