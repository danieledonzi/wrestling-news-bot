  "identities": {
    "allowed_classifications": [
      "existing_runtime",
      "existing_partial",
      "planned_canonical",
      "derived",
      "legacy_only"
    ],
    "fields": [
      {
        "name": "run_id",
        "classification": "existing_runtime",
        "description": "Observed run identity; one run may contain many correlations."
      },
      {
        "name": "article_id",
        "classification": "existing_runtime",
        "description": "Stable SHA-256 identity derived by the duplicate subsystem from canonical source URL."
      },
      {
        "name": "operation_id",
        "classification": "existing_runtime",
        "description": "Per-call-site Gemini operation token, normally UUID-bearing; grouping stability across every retry/fallback is not guaranteed. It is not a synonym of logical_request_id."
      },
      {
        "name": "attempt_index",
        "classification": "legacy_only",
        "description": "Legacy Gemini zero-based attempt ordinal; canonical attempt_number = attempt_index + 1 only when the same logical operation grouping is established."
      },
      {
        "name": "pair_id",
        "classification": "existing_runtime",
        "description": "Scoped identity for a duplicate article pair."
      },
      {
        "name": "report_key",
        "classification": "existing_runtime",
        "description": "Simone report identity."
      },
      {
        "name": "event_key",
        "classification": "existing_partial",
        "description": "Observed Simone event/night key, not universally populated."
      },
      {
        "name": "cluster_id",
        "classification": "existing_partial",
        "description": "Observed cluster identity, not universally populated."
      },
      {
        "name": "source_id",
        "classification": "existing_partial",
        "description": "Observed only on part of the pipeline."
      },
      {
        "name": "candidate_id",
        "classification": "existing_partial",
        "description": "Field exists in the Gemini ledger but the production sample was null; not a reliably populated identity."
      },
      {
        "name": "correlation_id",
        "classification": "planned_canonical",
        "description": "Planned end-to-end process/content correlation within a run."
      },
      {
        "name": "content_id",
        "classification": "planned_canonical",
        "description": "Planned stable source/content item identity."
      },
      {
        "name": "story_id",
        "classification": "planned_canonical",
        "description": "Planned editorial story identity that may group several content_id values."
      },
      {
        "name": "logical_request_id",
        "classification": "planned_canonical",
        "description": "Planned ID for one pipeline intention; stable across all retries and fallbacks for that intention."
      },
      {
        "name": "attempt_id",
        "classification": "planned_canonical",
        "description": "Planned unique ID for exactly one concrete attempt."
      }
    ],
    "relationships": [
      "run_id contains zero or more correlation_id values",
      "correlation_id links end-to-end events for one content/process",
      "story_id may group multiple content_id values",
      "logical_request_id contains one or more attempt_id values when calls occur",
      "pair_id identifies a duplicate-subsystem article pair",
      "report_key identifies one Simone report"
    ]
  },
  "attempt_contract": {
    "logical_request_id_stable_across_retry_and_fallback": true,
    "attempt_id_unique_per_concrete_attempt": true,
    "attempt_number_base": 1,
    "legacy_attempt_index_base": 0,
    "legacy_conversion": "attempt_number = attempt_index + 1 only after operation grouping is proven",
    "operation_id_equivalent_to_logical_request_id": false,
    "avoided_is_concrete_attempt": false
  },
  "outcome_contract": {
    "status_values": [
      "started",
      "success",
      "failed",
      "avoided",
      "pending",
      "skipped"
    ],
    "result_semantics": "Normalized immediate outcome payload/classification; optional and distinct from lifecycle and cause.",
    "reason_code_semantics": "Stable machine cause/purpose code; optional and distinct from outcome.",
    "namespaces_disjoint": true
  },
  "error_contract": {
    "classes": [
      "transient",
      "permanent",
      "validation",
      "upstream",
      "downstream",
      "invariant",
      "policy"
    ],
    "terminal_type": "boolean_or_null",
    "null_semantics": "No error classification applies or terminality is unknown outside an error event.",
    "non_error_requires_error_class": false
  },
  "model_contract": {
    "roles": [
      "selection",
      "duplicate_arbitration",
      "translation_generation",
      "report_translation",
      "quote_resolution",
      "quality_review"
    ],
    "latency_ms_minimum": 0,
    "fallback_same_logical_request": true
  },
  "artifact_refs_contract": {
    "type": "array",
    "item_type": "object",
    "required_item_fields": [
      "path",
      "relation"
    ],
    "optional_item_fields": [
      "artifact_type",
      "schema_version",
      "sha256"
    ],
    "relation_values": [
      "input",
      "output",
      "evidence"
    ],
    "embed_content": false
  },
  "legacy_mapping_kinds": [
    "exact",
    "derived",
    "partial",
    "no_canonical_equivalent",
    "planned_future_field"
  ],
  "legacy_field_mappings": [
    {
      "source": "gemini_call_ledger",
      "legacy_field": "run_id",
      "canonical_field": "run_id",
      "mapping_kind": "exact",
      "note": ""
    },
    {
      "source": "gemini_call_ledger",
      "legacy_field": "agent",
      "canonical_field": "agent",
      "mapping_kind": "partial",
      "note": "Raw agent is the editorial caller (Menzo, Bob, or Alfred); future model-attempt events use canonical agent Gemini while retaining caller context through request/event mappings."
    },
    {
      "source": "gemini_call_ledger",
      "legacy_field": "status",
      "canonical_field": "status",
      "mapping_kind": "partial",
      "note": "Legacy 'called' is not canonical: normalize with result/error evidence to started, success, or failed; avoided/failed still require event context."
    },
    {
      "source": "gemini_call_ledger",
      "legacy_field": "result",
      "canonical_field": "result",
      "mapping_kind": "partial",
      "note": "Normalize known classifications; free-form provider/error text such as 503 UNAVAILABLE high demand is not copied as a canonical result."
    },
    {
      "source": "gemini_call_ledger",
      "legacy_field": "reason",
      "canonical_field": "reason_code",
      "mapping_kind": "exact",
      "note": ""
    },
    {
      "source": "gemini_call_ledger",
      "legacy_field": "phase",
      "canonical_field": "event_type",
      "mapping_kind": "partial",
      "note": "Requires phase table and outcome context."
    },
    {
      "source": "gemini_call_ledger",
      "legacy_field": "operation_id",
      "canonical_field": "logical_request_id",
      "mapping_kind": "partial",
      "note": "Use only after proving stable grouping; never automatic equivalence."
    },
    {
      "source": "gemini_call_ledger",
      "legacy_field": "attempt_index",
      "canonical_field": "attempt_number",
      "mapping_kind": "derived",
      "note": "Zero-based legacy index plus one, conditional on valid request grouping."
    },
    {
      "source": "gemini_call_ledger",
      "legacy_field": "model",
      "canonical_field": "model_name",
      "mapping_kind": "partial",
      "note": "Precedence depends on requested-versus-actual analysis."
    },
    {
      "source": "gemini_call_ledger",
      "legacy_field": "model_requested",
      "canonical_field": "model_name",
      "mapping_kind": "partial",
      "note": "Precedence depends on requested-versus-actual analysis."
    },
    {
      "source": "gemini_call_ledger",
      "legacy_field": "actual_model",
      "canonical_field": "model_name",
      "mapping_kind": "partial",
      "note": "Precedence depends on requested-versus-actual analysis."
    },
    {
      "source": "master_log.timeline",
      "legacy_field": "agent",
      "canonical_field": "agent",
      "mapping_kind": "exact",
      "note": ""
    },
    {
      "source": "master_log.timeline",
      "legacy_field": "phase",
      "canonical_field": "event_type",
      "mapping_kind": "partial",
      "note": "Map raw phase using legacy_phase_mappings."
    },
    {
      "source": "duplicate_subsystem",
      "legacy_field": "article_id",
      "canonical_field": "article_id",
      "mapping_kind": "exact",
      "note": "Observed identity is available in the optional canonical envelope."
    },
    {
      "source": "duplicate_subsystem",
      "legacy_field": "pair_id",
      "canonical_field": "pair_id",
      "mapping_kind": "exact",
      "note": "Observed identity is available in the optional canonical envelope."
    },
    {
      "source": "duplicate_subsystem",
      "legacy_field": "left_article_id",
      "canonical_field": null,
      "mapping_kind": "no_canonical_equivalent",
      "note": "Retained as identity/context metadata until envelope extension."
    },
    {
      "source": "duplicate_subsystem",
      "legacy_field": "right_article_id",
      "canonical_field": null,
      "mapping_kind": "no_canonical_equivalent",
      "note": "Retained as identity/context metadata until envelope extension."
    },
    {
      "source": "duplicate_subsystem",
      "legacy_field": "scope",
      "canonical_field": "result",
      "mapping_kind": "partial",
      "note": "Requires field-specific normalization; do not copy blindly."
    },
    {
      "source": "duplicate_subsystem",
      "legacy_field": "final_disposition",
      "canonical_field": "result",
      "mapping_kind": "partial",
      "note": "Requires field-specific normalization; do not copy blindly."
    },
    {
      "source": "duplicate_subsystem",
      "legacy_field": "gemini_decision",
      "canonical_field": "result",
      "mapping_kind": "partial",
      "note": "Requires field-specific normalization; do not copy blindly."
    },
    {
      "source": "duplicate_subsystem",
      "legacy_field": "cache_status",
