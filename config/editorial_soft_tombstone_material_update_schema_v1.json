{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "decision", "new_fact", "temporal_basis"],
        "properties": {
          "ref": {"type": "string", "pattern": "^t[0-9]+$"},
          "decision": {"enum": ["MATERIAL_UPDATE", "NO_MATERIAL_UPDATE"]},
          "new_fact": {"type": ["string", "null"]},
          "temporal_basis": {"type": ["string", "null"]}
        }
      }
    }
  }
}
