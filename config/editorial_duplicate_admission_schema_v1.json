{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "admission_complete",
    "suspected_duplicates"
  ],
  "properties": {
    "admission_complete": {
      "type": "boolean"
    },
    "suspected_duplicates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "left_ref",
          "right_ref",
          "anchor_fact",
          "target_fact",
          "basis"
        ],
        "properties": {
          "left_ref": {
            "type": "string",
            "pattern": "^a[0-9]+$"
          },
          "right_ref": {
            "type": "string",
            "pattern": "^[ah][0-9]+$"
          },
          "basis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "anchor_fact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "target_fact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  }
}
